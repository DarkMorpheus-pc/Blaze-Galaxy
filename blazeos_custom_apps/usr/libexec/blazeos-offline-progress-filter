#!/usr/bin/awk -f
# DNF5 prints transaction items as [current/total].  Forward every line to the
# journal/console and convert monotonically increasing transaction progress to
# Plymouth's integer percentage protocol.
BEGIN { max_progress = 0 }
{
    print
    fflush()
    if (match($0, /\[[[:space:]]*([0-9]+)\/([0-9]+)[[:space:]]*\]/, item)) {
        current = item[1] + 0
        total = item[2] + 0
        if (total > 0) {
            progress = int((current * 100) / total)
            if (progress > 99) progress = 99
            if (progress > max_progress) {
                max_progress = progress
                system("/usr/bin/plymouth system-update --progress=" progress " >/dev/null 2>&1")
            }
        }
    }
}
