#!/bin/bash
# ==============================================================================
# BlazeOS Recovery Environment (BERE) GUI Launcher
# Root olarak DRM direct erişimi ile Niri compositor baslatilir.
# seatd veya logind gerektirmez: LIBSEAT_BACKEND=direct yeterlidir.
# Fallback: Weston kiosk. Her ikisi basarisiz olursa metin konsoluna duser.
# ==============================================================================
set -euo pipefail

export HOME=/root
export XDG_RUNTIME_DIR=/run/user/0
export TERM=linux
export XDG_SESSION_TYPE=wayland
# The recovery target starts before a graphical login session exists.  logind
# is therefore not guaranteed to own tty1; direct DRM access is the reliable
# path for this root-only rescue compositor.
export SEATD_VTY=1

# WebKit sandbox ve dmabuf render: recovery ortaminda gereksiz
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_FORCE_SANDBOX=0
export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
# Donanim hizlandirma kisitli VM veya GPU'larda Mesa yazilim rasterizer fallback
if [ ! -e /dev/dri/renderD128 ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
fi
# Niri: seat grubu kontrolunu atla
export NIRI_SKIP_SEAT_CHECK=1

# XDG_RUNTIME_DIR hazirla
mkdir -p /run/user/0
chmod 0700 /run/user/0

log() {
    echo "[BERE-GUI] $*" >&2
}

# seatd arka plan servisini baslat
SEATD_PID=""
cleanup() {
    if [ -n "$SEATD_PID" ]; then
        kill "$SEATD_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

if command -v seatd >/dev/null 2>&1; then
    log "seatd arka plan servisi baslatiliyor..."
    rm -f /run/seatd.sock
    seatd -u root -g root >/tmp/seatd.log 2>&1 &
    SEATD_PID=$!
    for _ in $(seq 1 20); do
        if [ -S /run/seatd.sock ]; then
            log "seatd hazir (/run/seatd.sock)."
            export LIBSEAT_BACKEND=seatd
            break
        fi
        sleep 0.1
    done
fi

# DRM aygit dugumunu bekle (maks 6 saniye)
log "DRM aygiti bekleniyor..."
for i in $(seq 1 60); do
    if ls /dev/dri/card* >/dev/null 2>&1; then
        log "DRM hazir: $(ls /dev/dri/card*)"
        break
    fi
    sleep 0.1
done

if ! ls /dev/dri/card* >/dev/null 2>&1; then
    log "UYARI: DRM aygiti bulunamadi, devam ediliyor..."
fi

# Niri ikilik kontrolu
NIRI_BIN=""
for path in /usr/bin/niri /usr/local/bin/niri; do
    if [ -x "$path" ]; then
        NIRI_BIN="$path"
        break
    fi
done

# 1. Asil girisim: Niri
if [ -n "$NIRI_BIN" ]; then
    log "Niri baslatiliyor (LIBSEAT_BACKEND=${LIBSEAT_BACKEND:-seatd}, SEATD_VTY=1)..."
    "$NIRI_BIN" --config /usr/share/berp-recovery/niri-recovery.kdl \
        >/tmp/bere-niri.log 2>&1 &
    NIRI_PID=$!
    GUI_READY=0
    for _ in $(seq 1 80); do
        if [ -S "/run/user/0/wayland-0" ]; then
            export WAYLAND_DISPLAY="wayland-0"
            GUI_READY=1
            break
        elif [ -S "/run/user/0/wayland-1" ]; then
            export WAYLAND_DISPLAY="wayland-1"
            GUI_READY=1
            break
        fi
        kill -0 "$NIRI_PID" 2>/dev/null || break
        sleep 0.1
    done
    if [ "$GUI_READY" -eq 1 ]; then
        log "Niri hazir ($WAYLAND_DISPLAY). berp-recovery-gui bekleniyor..."
        # berp-recovery-gui niri-recovery.kdl icinde spawn-at-startup ile baslatilir.
        # Surec baslatilamadiysa veya niri tek basina calisiyorsa buradan tetikle:
        if ! pgrep -f berp-recovery-gui >/dev/null 2>&1; then
            /usr/bin/berp-recovery-gui >/tmp/bere-gui.log 2>&1 &
        fi
        wait "$NIRI_PID" 2>/dev/null || true
        log "Niri oturumu tamamlandi."
        exit 0
    else
        log "Niri GUI soketi olusmadi; log: /tmp/bere-niri.log"
        kill "$NIRI_PID" 2>/dev/null || true
        wait "$NIRI_PID" 2>/dev/null || true
    fi
fi

# 2. Fallback: Weston kiosk modu (Weston 15 standard)
if command -v weston >/dev/null 2>&1; then
    log "Weston kiosk moduna geciliyor (--backend=drm --shell=kiosk)..."
    if weston --backend=drm --shell=kiosk --log=/tmp/weston-recovery.log -- /usr/bin/berp-recovery-gui; then
        exit 0
    fi
    log "Weston da basarisiz oldu. Log: /tmp/weston-recovery.log"
fi

# 3. Hicbiri calismadi veya GUI kapandi: Asla siyah ekranda kalma, dogrudan BERP konsol TUI kurtarmasina gec
log "BERP konsol (TUI) kurtarma moduna geciliyor..."
if command -v reset >/dev/null 2>&1; then
    reset || true
fi
clear || true
if [ -x /usr/bin/blaze-recovery ]; then
    exec /usr/bin/blaze-recovery </dev/tty1 >/dev/tty1 2>&1
fi
exit 1
