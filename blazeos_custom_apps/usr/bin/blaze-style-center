def tr(text: str) -> str:
    return TEXT.get(LANG, {}).get(text, text)


PRESET_NAMES = {
    "en": {"gnome": "Pure GNOME", "mac": "Bottom Dock", "ubuntu": "Left Dock", "windows": "Classic Panel", "focus": "Focus", "blaze": "Blaze", "org.fedoraproject.fedora.desktop": "Fedora", "org.fedoraproject.fedoradark.desktop": "Fedora Dark", "org.kde.breeze.desktop": "Breeze", "org.kde.breezedark.desktop": "Breeze Dark", "org.kde.breezetwilight.desktop": "Breeze Twilight", "com.github.varlesh.arc": "Arc", "com.github.varlesh.arc-dark": "Arc Dark", "com.github.varlesh.materia": "Materia", "com.github.varlesh.materia-dark": "Materia Dark"},
    "de": {"gnome": "Reines GNOME", "mac": "Dock unten", "ubuntu": "Dock links", "windows": "Klassische Leiste", "focus": "Fokus", "blaze": "Blaze"},
    "es": {"gnome": "GNOME puro", "mac": "Dock inferior", "ubuntu": "Dock izquierdo", "windows": "Panel clásico", "focus": "Enfoque", "blaze": "Blaze"},
    "ru": {"gnome": "Чистый GNOME", "mac": "Нижняя панель", "ubuntu": "Левая панель", "windows": "Классическая панель", "focus": "Фокус", "blaze": "Blaze"},
}


def preset_name(preset: dict) -> str:
    return PRESET_NAMES.get(LANG, {}).get(preset["id"], PRESET_NAMES.get("en", {}).get(preset["id"], preset["name"]))


def preset_desc(preset: dict) -> str:
    if LANG == "tr":
        return preset["desc"]
    generic = {"en": "Stable, reversible desktop preset", "de": "Stabile, rückgängig machbare Desktop-Vorlage", "es": "Estilo de escritorio estable y reversible", "ru": "Стабильный обратимый стиль рабочего стола"}
    return generic.get(LANG, preset["desc"])


def run(args: list[str], *, input_text: str | None = None, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, input=input_text, text=True, capture_output=True, check=check)


def desktop() -> str:
    value = " ".join((os.environ.get("XDG_CURRENT_DESKTOP", ""), os.environ.get("DESKTOP_SESSION", ""))).lower()
    if "gnome" in value:
        return "gnome"
    if "kde" in value or "plasma" in value:
        return "kde"
    selected = Path("/etc/blazeos-selected-session")
    if selected.exists():
        value = selected.read_text(errors="replace").lower()
        if "gnome" in value:
            return "gnome"
        if "plasma" in value or "kde" in value:
            return "kde"
    return "unsupported"


