#!/bin/bash
# SolarUI Wayland Session Wrapper for GDM / Display Managers
export XDG_CURRENT_DESKTOP="SolarUI:gnome:niri"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="SolarUI"
export DESKTOP_SESSION="SolarUI"
export MOZ_ENABLE_WAYLAND="1"
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
export WLR_NO_HARDWARE_CURSORS="1"
export WLR_RENDERER_ALLOW_SOFTWARE="1"
export ELECTRON_OZONE_PLATFORM_HINT="wayland"
export NVD_BACKEND="direct"
export __GL_GSYNC_ALLOWED="0"
export __GL_VRR_ALLOWED="0"
export WEBKIT_DISABLE_DMABUF_RENDERER="1"

# Check if running in a virtual machine (QEMU, KVM, VirtualBox, VMware) or software rasterizer
if systemd-detect-virt -q 2>/dev/null || grep -qE -i 'hypervisor|qemu|kvm|virtualbox|vmware' /proc/cpuinfo /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    export QSG_RENDER_LOOP="basic"
fi

LOG_DIR="${HOME}/.local/share/solarui"
mkdir -p "$LOG_DIR" 2>/dev/null || :
LOG_FILE="${LOG_DIR}/session.log"

echo "=== SolarUI Session Started: $(date) ===" >> "$LOG_FILE" 2>&1
echo "User: $(whoami) (UID: $(id -u)), Home: $HOME" >> "$LOG_FILE" 2>&1
echo "Session ID: ${XDG_SESSION_ID:-none}, VT: ${XDG_VTNR:-none}" >> "$LOG_FILE" 2>&1

# Ensure session is active in logind without touching hardware VTs
if [ -n "$XDG_SESSION_ID" ]; then
    loginctl activate "$XDG_SESSION_ID" 2>> "$LOG_FILE" || :
fi

# Auto-launch Anaconda Welcome Screen / Installer on Live ISO session
(
    if grep -qE 'rd\.live\.image|root=live:' /proc/cmdline 2>/dev/null || [ -d /run/initramfs/live ]; then
        for i in $(seq 1 50); do
            for w in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
                if [ -S "$w" ] && [ ! -L "$w" ]; then
                    export WAYLAND_DISPLAY="$(basename "$w")"
                    break
                fi
            done
            if [ -n "$WAYLAND_DISPLAY" ]; then
                sleep 4
                echo "Live environment detected with WAYLAND_DISPLAY=${WAYLAND_DISPLAY}, launching Anaconda installer..." >> "$LOG_FILE" 2>&1
                if [ -x /usr/bin/liveinst ]; then
                    /usr/bin/liveinst >> "$LOG_FILE" 2>&1 &
                elif [ -x /usr/share/anaconda/gnome/fedora-welcome ]; then
                    /usr/share/anaconda/gnome/fedora-welcome >> "$LOG_FILE" 2>&1 &
                fi
                break
            fi
            sleep 0.5
        done
    fi
) &

# Launch SolarUI Session
/usr/bin/solar-session >> "$LOG_FILE" 2>&1
EXIT_CODE=$?

# If initial launch failed, try resilient software-rendering mode before any fallback
if [ $EXIT_CODE -ne 0 ]; then
    echo "SolarUI primary session exited with code $EXIT_CODE. Attempting resilient software fallback..." >> "$LOG_FILE" 2>&1
    export WLR_RENDERER="pixman"
    export LIBGL_ALWAYS_SOFTWARE="1"
    export QSG_RENDER_LOOP="basic"
    sleep 1
    /usr/bin/solar-session >> "$LOG_FILE" 2>&1
    EXIT_CODE=$?
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo "SolarUI session terminated with code $EXIT_CODE." >> "$LOG_FILE" 2>&1
fi
exit $EXIT_CODE
