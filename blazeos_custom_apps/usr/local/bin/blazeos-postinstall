#!/bin/bash
# ==============================================================================
# BlazeOS Post-Installation Firstboot Setup
# Ensures proper user session, cleans liveuser, sets GDM, applies bootloader
# ==============================================================================
set -e

# Live ISO detection: exit immediately before modifying anything
if grep -qE 'rd\.live\.image|root=live:' /proc/cmdline 2>/dev/null || [ -d /run/initramfs/live ] || [ -f /run/liveuser ]; then
    echo "Live environment detected; installed-system setup skipped."
    exit 0
fi

LOG="/var/log/blazeos-postinstall.log"
exec >> "$LOG" 2>&1
echo "=== Starting BlazeOS Post-Install at $(date) ==="

# 1. Check if Apple-Style OOBE has completed
if [ ! -f /etc/blazeos-setup-completed ]; then
    echo "BlazeOS first-boot OOBE pending. Ensuring SDDM 00-blaze-oobe.conf is active..."
    rm -f /etc/sddm.conf.d/autologin.conf

    # Ensure home directory and permissions for blaze-setup user
    mkdir -p /var/lib/blaze-setup
    chown -R 961:961 /var/lib/blaze-setup 2>/dev/null || true
    chmod 755 /var/lib/blaze-setup 2>/dev/null || true
    chmod 0440 /etc/sudoers.d/99-blaze-setup 2>/dev/null || true

    mkdir -p /etc/systemd/system
    mkdir -p /etc/systemd/system/graphical.target.wants
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service 2>/dev/null || true
    ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/graphical.target.wants/sddm.service 2>/dev/null || true
    ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/multi-user.target.wants/display-manager.service 2>/dev/null || true
    ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target 2>/dev/null || true
    systemctl set-default graphical.target 2>/dev/null || true
    systemctl enable sddm.service 2>/dev/null || true

    # If the system is currently in or headed to multi-user.target, switch to graphical.target immediately
    if ! systemctl is-active --quiet graphical.target; then
        echo "Activating graphical.target for OOBE..."
        systemctl isolate --no-block graphical.target 2>/dev/null || systemctl start --no-block sddm.service 2>/dev/null || true
    fi

    echo "=== OOBE Firstboot Preparation Complete ==="
    exit 0
fi

# 1. Resolve Primary Human User or migrate/create fallback
FIRST_HUMAN_USER=$(awk -F: '$3 >= 1000 && $3 < 65534 && $1 != "liveuser" {print $1; exit}' /etc/passwd)

if [ -z "$FIRST_HUMAN_USER" ]; then
    echo "No custom human user found from installer. Setting up primary user 'blaze'..."
    if id -u liveuser &>/dev/null; then
        # Migrate liveuser to blaze preserving home configuration
        usermod -l blaze -d /home/blaze -m liveuser 2>/dev/null || true
        groupmod -n blaze liveuser 2>/dev/null || true
        FIRST_HUMAN_USER="blaze"
    else
        useradd -m -s /bin/bash -U blaze 2>/dev/null || true
        FIRST_HUMAN_USER="blaze"
    fi
    # Never publish a predictable fallback password. The first-boot assistant
    # creates the real human account; this emergency fallback stays locked.
    passwd -l blaze 2>/dev/null || true
else
    # Custom human user exists, purge lingering liveuser
    if id -u liveuser &>/dev/null; then
        echo "Purging lingering liveuser account..."
        userdel -rf liveuser 2>/dev/null || true
        rm -rf /home/liveuser /var/lib/AccountsService/users/liveuser /etc/sudoers.d/liveuser
    fi
fi

# Ensure valid hostname and /etc/hosts
if [ ! -s /etc/hostname ] || grep -qiE '^(localhost|localhost\.localdomain)?$' /etc/hostname 2>/dev/null; then
    echo "blazeos" > /etc/hostname
    hostnamectl set-hostname blazeos 2>/dev/null || true
fi
if ! grep -q "blazeos" /etc/hosts 2>/dev/null; then
    cat > /etc/hosts << 'HOSTSEOF'
127.0.0.1   localhost localhost.localdomain blazeos
::1         localhost localhost.localdomain blazeos
HOSTSEOF
fi
# Ensure setuid permissions for rootless containers & Ptyxis/toolbox instant startup
chmod 4755 /usr/bin/newuidmap /usr/bin/newgidmap /usr/sbin/newuidmap /usr/sbin/newgidmap 2>/dev/null || true

# 2. Configure SDDM & GDM for Primary Human User
echo "Ensuring SDDM and display manager configuration for $FIRST_HUMAN_USER..."
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-blaze-session.conf << 'SDDMEOF'
[General]
DisplayServer=wayland
GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Wayland]
CompositorCommand=weston --shell=kiosk
SDDMEOF

# OOBE owns the user's autologin choice. Never create autologin here: doing so
# bypasses SDDM and causes a fresh login keyring password prompt. If OOBE made
# an autologin file, keep it and only normalize its selected desktop later.
if [ -f /etc/sddm.conf.d/autologin.conf ] &&
   ! grep -q "^User=${FIRST_HUMAN_USER}$" /etc/sddm.conf.d/autologin.conf; then
    echo "Removing stale autologin configuration for another account."
    rm -f /etc/sddm.conf.d/autologin.conf
fi

mkdir -p /etc/systemd/system
ln -sf /usr/lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true
systemctl enable sddm.service 2>/dev/null || true

mkdir -p /etc/gdm
cat > /etc/gdm/custom.conf << 'GDMEOF'
# GDM configuration storage
[daemon]
WaylandEnable=true
DefaultSession=solarui.desktop
InitialSetupEnable=false

[security]

[debug]
GDMEOF

# 3. Configure AccountsService for all human users (UID >= 1000)
echo "Configuring user sessions in AccountsService..."
mkdir -p /var/lib/AccountsService/users
while IFS=: read -r user pass uid gid gecos home shell; do
    if [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ] && [ "$user" != "liveuser" ]; then
        echo "Found user: $user (UID: $uid)"
        cat > "/var/lib/AccountsService/users/$user" << ASCEOF
[User]
Session=solarui
SessionType=wayland
Icon=/usr/share/icons/hicolor/256x256/apps/solarui.png
ASCEOF
        chmod 0600 "/var/lib/AccountsService/users/$user"
        chown root:root "/var/lib/AccountsService/users/$user"

        for g in wheel video audio render input; do
            usermod -aG "$g" "$user" 2>/dev/null || true
        done

        if [ -d "$home" ]; then
            mkdir -p "$home/.config/solarui" "$home/.config/noctalia"
            if [ ! -f "$home/.config/noctalia/settings.toml" ] && [ -f /etc/skel/.config/noctalia/settings.toml ]; then
                cp -f /etc/skel/.config/noctalia/settings.toml "$home/.config/noctalia/"
            fi
            if [ ! -f "$home/.config/solarui/niri.kdl" ] && [ -f /etc/solarui/niri.kdl ]; then
                cp -f /etc/solarui/niri.kdl "$home/.config/solarui/"
            fi
            # Caelestia shell config (fixes grey screen / crash on first login)
            if [ ! -d "$home/.config/caelestia" ] && [ -d /etc/skel/.config/caelestia ]; then
                cp -a /etc/skel/.config/caelestia "$home/.config/caelestia"
            fi
            # Quickshell / Caelestia QML config (critical for shell rendering)
            if [ ! -d "$home/.config/quickshell" ] && [ -d /etc/skel/.config/quickshell ]; then
                cp -a /etc/skel/.config/quickshell "$home/.config/quickshell"
            fi
            chown -R "$user:$user" "$home/.config" 2>/dev/null || true
        fi
    fi
done < /etc/passwd

# 4. Resolve and provision the selected desktop. SolarUI is the only offline
# stock desktop. Optional desktops come exclusively from enabled Fedora repos.
DNF_BIN="$(command -v dnf5 || command -v dnf || true)"
CHOICE="solarui"
[ -f /etc/blazeos-desktop-choice ] && CHOICE=$(tr -d ' \n\r' < /etc/blazeos-desktop-choice)

install_packages() {
    [ -n "$DNF_BIN" ] || return 1
    timeout 15m "$DNF_BIN" install -y --setopt=install_weak_deps=False "$@"
}

install_environment() {
    [ -n "$DNF_BIN" ] || return 1
    timeout 15m "$DNF_BIN" environment install -y "$1"
}

set_nodisplay() {
    local file="$1" value="$2"
    [ -f "$file" ] || return 0
    if grep -q '^NoDisplay=' "$file"; then
        sed -i "s/^NoDisplay=.*/NoDisplay=${value}/" "$file"
    else
        sed -i "/^\[Desktop Entry\]/a NoDisplay=${value}" "$file"
    fi
}

set_default_session() {
    local desktop="$1" session="${1%.desktop}"
    if [ ! -f "/usr/share/wayland-sessions/$desktop" ] && [ ! -f "/usr/share/xsessions/$desktop" ]; then
        echo "Requested session file is missing: $desktop"
        return 1
    fi
    sed -i "s/^DefaultSession=.*/DefaultSession=${desktop}/" /etc/gdm/custom.conf 2>/dev/null || true
    sed -i "s/^Session=.*/Session=${desktop}/" /etc/sddm.conf.d/autologin.conf 2>/dev/null || true
    for account in /var/lib/AccountsService/users/*; do
        [ -f "$account" ] || continue
        sed -i "s/^Session=.*/Session=${session}/" "$account"
    done
}

echo "Desktop choice: $CHOICE"
SELECTED_DESKTOP="solarui.desktop"
PROVISION_OK=1
case "$CHOICE" in
    solarui|solarui_pure)
        ;;
    niri)
        set_nodisplay /usr/share/wayland-sessions/niri.desktop false
        SELECTED_DESKTOP="niri.desktop"
        ;;
    gnome)
        rpm -q gnome-shell >/dev/null 2>&1 || install_packages gnome-shell gnome-session gnome-control-center gnome-settings-daemon nautilus ptyxis || PROVISION_OK=0
        SELECTED_DESKTOP="gnome.desktop"
        ;;
    kde)
        rpm -q plasma-workspace-wayland >/dev/null 2>&1 || install_environment kde-desktop-environment || PROVISION_OK=0
        SELECTED_DESKTOP="plasma.desktop"
        ;;
    cosmic)
        rpm -q cosmic-session >/dev/null 2>&1 || install_environment cosmic-desktop-environment || PROVISION_OK=0
        SELECTED_DESKTOP="cosmic.desktop"
        ;;
    hyprland)
        rpm -q hyprland >/dev/null 2>&1 || install_packages hyprland foot wofi waybar || PROVISION_OK=0
        SELECTED_DESKTOP="hyprland.desktop"
        ;;
    cinnamon)
        rpm -q cinnamon >/dev/null 2>&1 || install_environment cinnamon-desktop-environment || PROVISION_OK=0
        SELECTED_DESKTOP="cinnamon.desktop"
        [ -f /usr/share/wayland-sessions/cinnamon-wayland.desktop ] && SELECTED_DESKTOP="cinnamon-wayland.desktop"
        ;;
    xfce)
        rpm -q xfce4-session >/dev/null 2>&1 || install_environment xfce-desktop-environment || PROVISION_OK=0
        SELECTED_DESKTOP="xfce.desktop"
        ;;
    sway)
        rpm -q sway >/dev/null 2>&1 || install_environment sway-desktop-environment || PROVISION_OK=0
        SELECTED_DESKTOP="sway.desktop"
        ;;
    *)
        echo "Unknown desktop choice '$CHOICE'; falling back to SolarUI."
        CHOICE="solarui"
        ;;
esac

set_nodisplay /usr/share/wayland-sessions/gnome.desktop true
set_nodisplay /usr/share/wayland-sessions/niri.desktop true
set_nodisplay /usr/share/wayland-sessions/solarui.desktop false

if [ "$PROVISION_OK" -eq 1 ] && set_default_session "$SELECTED_DESKTOP"; then
    [ "$CHOICE" = "gnome" ] && set_nodisplay /usr/share/wayland-sessions/gnome.desktop false
    [ "$CHOICE" = "niri" ] && set_nodisplay /usr/share/wayland-sessions/niri.desktop false
else
    echo "Optional desktop provisioning failed; SolarUI remains active and setup will retry next boot."
    set_default_session solarui.desktop || true
    exit 1
fi

# Synchronize GDM and AccountsService user session definitions
DEFAULT_SESSION_DESKTOP=$(grep -E '^DefaultSession=' /etc/gdm/custom.conf 2>/dev/null | cut -d= -f2 | tr -d ' \r\n')
if [ -n "$DEFAULT_SESSION_DESKTOP" ]; then
    SESSION_NAME="${DEFAULT_SESSION_DESKTOP%.desktop}"
    SESSION_TYPE="wayland"
    if [ -f "/usr/share/wayland-sessions/${DEFAULT_SESSION_DESKTOP}" ] || [ -f "/usr/share/wayland-sessions/${SESSION_NAME}.desktop" ]; then
        SESSION_TYPE="wayland"
    elif [ -f "/usr/share/xsessions/${DEFAULT_SESSION_DESKTOP}" ] || [ -f "/usr/share/xsessions/${SESSION_NAME}.desktop" ]; then
        SESSION_TYPE="x11"
    fi

    while IFS=: read -r user pass uid gid gecos home shell; do
        if [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ] && [ "$user" != "liveuser" ]; then
            ACCOUNT="/var/lib/AccountsService/users/$user"
            if [ -f "$ACCOUNT" ]; then
                sed -i "s/^Session=.*/Session=${SESSION_NAME}/" "$ACCOUNT"
                sed -i "s/^XSession=.*/XSession=${SESSION_NAME}/" "$ACCOUNT"
                sed -i "s/^SessionType=.*/SessionType=${SESSION_TYPE}/" "$ACCOUNT"
                restorecon -F "$ACCOUNT" 2>/dev/null || true
            fi
        fi
    done < /etc/passwd
fi

# 5. Check bootloader choice
if [ -f /etc/blazeos-bootloader-choice ]; then
    BOOT_CHOICE=$(cat /etc/blazeos-bootloader-choice | tr -d ' \n\r')
    echo "Bootloader choice: $BOOT_CHOICE"
    if [ "$BOOT_CHOICE" = "limine" ]; then
        if [ -x /usr/local/bin/blaze-bootloader ]; then
            echo "Switching to Limine..."
            /usr/local/bin/blaze-bootloader switch-to-limine || true
        fi
    fi
fi

# 6. Rebuild the real GRUB configuration, then repair the small EFI redirect.
# Fedora's UEFI grub.cfg under EFI/fedora must remain a stub; writing the full
# grub2-mkconfig output there can leave firmware at a bare `grub>` prompt.
echo "Ensuring GRUB and its EFI redirect are up-to-date..."
if [ -d /boot/grub2 ]; then
    grub2-mkconfig -o /boot/grub2/grub.cfg || true
fi
if [ -d /sys/firmware/efi ] && [ -d /boot/efi ]; then
    /usr/bin/gen_grub_cfgstub /boot/grub2 /boot/efi/EFI/fedora || true
fi

# 7. Self disable this service so it never runs again
echo "Disabling blazeos-postinstall.service..."
systemctl disable blazeos-postinstall.service 2>/dev/null || true
echo "=== BlazeOS Post-Install Complete at $(date) ==="
exit 0
