    # --------------------------------------------------------------------------
    # 5. INFO PAGE
    # --------------------------------------------------------------------------
    def build_info_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Bilgi" if self.is_tr else "Info")
        page.set_icon_name("dialog-information-symbolic")
        page.set_name("info")

        pref_group = Adw.PreferencesGroup(
            title="Sistem ve Donanım Bilgisi" if self.is_tr else "System & Hardware Specs",
            description=f"{DISTRO_NAME} donanım ve yazılım özeti." if self.is_tr else f"{DISTRO_NAME} system overview."
        )
        page.add(pref_group)

        # Fastfetch output view inside a clean styled ScrolledWindow
        self.info_buffer = Gtk.TextBuffer()
        info_view = Gtk.TextView(buffer=self.info_buffer, editable=False, monospace=True)
        info_view.set_bottom_margin(12)
        info_view.set_top_margin(12)
        info_view.set_left_margin(16)
        info_view.set_right_margin(16)

        scrolled = Gtk.ScrolledWindow(child=info_view, min_content_height=380)
        pref_group.add(scrolled)

        self.load_system_info()
        self.add(page)

    # --------------------------------------------------------------------------
    # HELPERS & LOGIC
    # --------------------------------------------------------------------------
    def run_task(self, name, command):
        self.set_visible_page_name("updates")
        self.expander.set_expanded(True)
        cmd_str = " ".join(command)
        self.log_buffer.set_text(f"=== {name} Başlatıldı ===\nKomut: {cmd_str}\n\n")

        def task_thread():
            try:
                p = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
                for line in p.stdout:
                    GLib.idle_add(self.append_log, line)
                p.wait()
                GLib.idle_add(self.append_log, f"\n=== {name} Tamamlandı (Çıkış Kodu: {p.returncode}) ===\n")
                if p.returncode == 0:
                    GLib.idle_add(self.show_toast, f"{name} başarıyla tamamlandı.")
                else:
                    GLib.idle_add(self.show_toast, f"{name} hata ile sonuçlandı (Kod: {p.returncode}).")
            except Exception as ex:
                GLib.idle_add(self.append_log, f"\nHATA: {ex}\n")
                GLib.idle_add(self.show_toast, f"Hata: {ex}")

        threading.Thread(target=task_thread, daemon=True).start()

    def append_log(self, text):
        end_iter = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end_iter, text)

    def get_current_session(self):
        user = os.environ.get("USER", "liveuser")
        acc_file = f"/var/lib/AccountsService/users/{user}"
        if os.path.exists(acc_file):
            try:
                with open(acc_file, "r") as f:
                    for line in f:
                        if line.startswith("Session="):
                            return line.split("=", 1)[1].strip()
            except Exception:
                pass
        return "solarui"

    def set_desktop_session(self, de):
        user = os.environ.get("USER", "liveuser")
        session_name = de["session"]
        session_desktop = de["session_desktop"]
        session_type = de["session_type"]
        acc_file = f"/var/lib/AccountsService/users/{user}"
        content = f"[User]\nSession={session_name}\nSessionType={session_type}\nXSession={session_name}\nIcon=/usr/share/icons/hicolor/256x256/apps/solarui.png\n"

        hide_gnome = "true" if session_name == "solarui" else "false"

        def do_write():
            script = (
                f"mkdir -p /var/lib/AccountsService/users && "
                f"cat > {acc_file} << 'EOF'\n{content}EOF\n"
                f"chmod 0600 {acc_file}\n"
                f"restorecon -F {acc_file} 2>/dev/null || true\n"
                f"if [ -f /usr/share/wayland-sessions/gnome.desktop ]; then "
                f"  sed -i '/^NoDisplay=/d' /usr/share/wayland-sessions/gnome.desktop; "
                f"  sed -i '/^\\[Desktop Entry\\]/a NoDisplay={hide_gnome}' /usr/share/wayland-sessions/gnome.desktop; "
                f"fi\n"
                f"if [ -f /etc/gdm/custom.conf ]; then "
                f"  sed -i 's/^DefaultSession=.*/DefaultSession={session_desktop}/' /etc/gdm/custom.conf 2>/dev/null || true; "
                f"fi\n"
            )
            res = subprocess.run(["pkexec", "sh", "-c", script], capture_output=True, text=True)
            if res.returncode == 0:
                msg = (f"Varsayılan masaüstü {de['name']} olarak ayarlandı. Oturumu kapattığınızda geçerli olur."
                       if self.is_tr else f"Default session set to {de['name']}. Active on next login.")
            else:
                msg = f"Hata: {res.stderr}"
            GLib.idle_add(self.show_toast, msg)

        threading.Thread(target=do_write, daemon=True).start()

    def install_desktop_environment(self, de):
        if not de.get("packages"):
            self.show_toast("Bu ortam zaten kuruludur." if self.is_tr else "This desktop is already installed.")
            return

        cmd = ["pkexec", "dnf", "install", "-y", "--setopt=install_weak_deps=False"] + de["packages"].split()
        self.run_task(f"{de['name']} Kurulumu", cmd)

    def toggle_dock(self):
        cmd = "gnome-extensions enable dash-to-dock@vswitch.com 2>/dev/null || gnome-extensions toggle dash-to-dock@micxgx.gmail.com 2>/dev/null || true"
        subprocess.run(["sh", "-c", cmd])
        self.show_toast("Dash to Dock durumu güncellendi." if self.is_tr else "Dash to Dock toggled.")

    def toggle_solar_taskbar(self):
        subprocess.run(["solar-shell", "toggle-taskbar"], stderr=subprocess.DEVNULL)
        self.show_toast("SolarUI Görev Çubuğu durumu güncellendi." if self.is_tr else "SolarUI Taskbar toggled.")

    def get_zram_status(self):
        try:
            with open("/proc/swaps", "r") as f:
                content = f.read()
            if "zram" in content:
                for line in content.splitlines():
                    if "zram" in line:
                        parts = line.split()
                        size_mb = int(parts[2]) // 1024
                        return f"Aktif - {size_mb} MB ZRAM Sıkıştırılmış Takas Belleği (zstd)" if self.is_tr else f"Active - {size_mb} MB Compressed ZRAM Swap (zstd)"
            return "ZRAM yapılandırılmamış" if self.is_tr else "ZRAM not active"
        except Exception:
            return "Bilinmiyor" if self.is_tr else "Unknown"

    def refresh_zram_status(self):
        self.row_zram.set_subtitle(self.get_zram_status())
        self.show_toast("ZRAM durumu yenilendi." if self.is_tr else "ZRAM status refreshed.")

    def load_system_info(self):
        def load_thread():
            try:
                cmd = ["/usr/bin/fastfetch", "--pipe", "false"]
                if os.path.exists("/usr/share/blazeos/fastfetch/config.jsonc"):
                    cmd = ["/usr/bin/fastfetch", "--config", "/usr/share/blazeos/fastfetch/config.jsonc", "--pipe", "false"]
                out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode("utf-8", errors="replace")
                # Clean ANSI escape sequences for GTK TextView display
                out = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', out)
                out = re.sub(r'\x1b\].*?\x07', '', out)
            except Exception:
                uname_out = os.uname()
                out = f"OS: {DISTRO_NAME}\nKernel: {uname_out.release} ({uname_out.machine})\nDesktop: SolarUI (Niri Wayland)\n"
            GLib.idle_add(lambda: self.info_buffer.set_text(out))

        threading.Thread(target=load_thread, daemon=True).start()

    def show_toast(self, message):
        toast = Adw.Toast.new(message)
        toast.set_timeout(3)
        self.add_toast(toast)


class BlazeControlApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = BlazeControlWindow(application=self)
        win.present()


def main():
    app = BlazeControlApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
