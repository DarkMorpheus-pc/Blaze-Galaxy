        page.add(pref_group)

        # Feral GameMode
        row_game = Adw.ActionRow(
            title="Feral GameMode" if self.is_tr else "Feral GameMode",
            subtitle="Oyunlarda CPU frekansını, I/O önceliğini ve GPU performansını maksimize eder." if self.is_tr
                     else "Optimizes CPU governor, scheduler, and GPU clocks during games."
