        row_pwr.add_suffix(btn_sav)
        pref_group.add(row_pwr)

        # ZRAM Status
        zram_info = self.get_zram_status()
        self.row_zram = Adw.ActionRow(
            title="ZRAM Bellek Sıkıştırması" if self.is_tr else "ZRAM Memory Compression",
            subtitle=zram_info
        )
        btn_zram_refresh = Gtk.Button(label="Yenile" if self.is_tr else "Refresh", valign=Gtk.Align.CENTER)
        btn_zram_refresh.connect("clicked", lambda _: self.refresh_zram_status())
        self.row_zram.add_suffix(btn_zram_refresh)
        pref_group.add(self.row_zram)

        # Kernel Optimizer Tool
        row_opt = Adw.ActionRow(
            title="BlazeOS Çekirdek ve G/Ç İyileştirmesi" if self.is_tr else "BlazeOS Kernel & I/O Optimizer",
            subtitle="BBR TCP, vm.swappiness, vm.max_map_count ve disk G/Ç parametrelerini uygular." if self.is_tr
                     else "Applies kernel sysctl tweaks, BBR TCP, swappiness, and I/O scheduler."
        )
        btn_opt = Gtk.Button(label="Uygula" if self.is_tr else "Apply", valign=Gtk.Align.CENTER)
        btn_opt.connect("clicked", lambda _: self.run_task(
            "Blaze Optimize",
            ["pkexec", "/usr/local/bin/blaze-optimize", "gaming"]
        ))
        row_opt.add_suffix(btn_opt)
        pref_group.add(row_opt)

        self.add(page)

