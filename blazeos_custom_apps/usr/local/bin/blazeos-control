        btn_game = Gtk.Button(label="Etkinleştir" if self.is_tr else "Enable", valign=Gtk.Align.CENTER)
        btn_game.add_css_class("suggested-action")
        btn_game.connect("clicked", lambda _: self.run_task(
            "GameMode",
            ["systemctl", "--user", "enable", "--now", "gamemoded"]
        ))
        row_game.add_suffix(btn_game)
        pref_group.add(row_game)

        # Power Profiles
        row_pwr = Adw.ActionRow(
            title="Güç ve Enerji Profili" if self.is_tr else "Power Profile",
            subtitle="Performans, Dengeli veya Güç Tasarrufu modu." if self.is_tr
                     else "Select system power behavior (powerprofilesctl)."
