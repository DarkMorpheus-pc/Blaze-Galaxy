        btn_perf = Gtk.Button(label="Performans" if self.is_tr else "Performance", valign=Gtk.Align.CENTER)
        btn_perf.connect("clicked", lambda _: self.run_task("Power Profile", ["powerprofilesctl", "set", "performance"]))

        btn_bal = Gtk.Button(label="Dengeli" if self.is_tr else "Balanced", valign=Gtk.Align.CENTER)
        btn_bal.connect("clicked", lambda _: self.run_task("Power Profile", ["powerprofilesctl", "set", "balanced"]))

        btn_sav = Gtk.Button(label="Tasarruf" if self.is_tr else "Power Saver", valign=Gtk.Align.CENTER)
