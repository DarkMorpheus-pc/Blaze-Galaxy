    # 3. PERFORMANCE PAGE
    # --------------------------------------------------------------------------
    def build_performance_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Performans" if self.is_tr else "Performance")
        page.set_icon_name("system-run-symbolic")
        page.set_name("performance")

        pref_group = Adw.PreferencesGroup(
