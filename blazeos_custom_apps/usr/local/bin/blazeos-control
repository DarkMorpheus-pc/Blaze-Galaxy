class BlazeControlWindow(Adw.PreferencesWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.is_tr = os.environ.get("LANG", "").startswith("tr")
        self.set_title("BlazeOS Merkezi" if self.is_tr else "BlazeOS Control")
        self.set_default_size(920, 680)

        self.build_updates_page()
        self.build_desktop_page()
        self.build_performance_page()
        self.build_tools_page()
        self.build_info_page()

    # --------------------------------------------------------------------------
    # 1. UPDATES PAGE
    # --------------------------------------------------------------------------
    def build_updates_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Güncelleme" if self.is_tr else "Updates")
        page.set_icon_name("view-refresh-symbolic")
        page.set_name("updates")

        pref_group = Adw.PreferencesGroup(
            title="Sistem Güncellemeleri" if self.is_tr else "System Updates",
            description="En son güvenlik yamalarını, çekirdeği ve paketleri denetle." if self.is_tr
                        else "Check and apply the latest security patches, kernel, and software packages."
        )
        page.add(pref_group)

        # Full Update
        row_full = Adw.ActionRow(
            title="Tam Güncelleme" if self.is_tr else "Full System Update",
            subtitle="Tüm sistem paketleri, çekirdek, donanım sürücüleri ve güvenlik yamaları." if self.is_tr
                     else "All system packages, kernel, firmware, and user applications."
        )
        btn_full = Gtk.Button(label="Güncelle" if self.is_tr else "Update", valign=Gtk.Align.CENTER)
        btn_full.add_css_class("suggested-action")
        btn_full.connect("clicked", lambda _: self.run_task(
            "Tam Güncelleme" if self.is_tr else "Full System Update",
            ["pkexec", "/usr/libexec/blazeos-welcome-helper", "update-all"]
        ))
        row_full.add_suffix(btn_full)
        pref_group.add(row_full)

        # Drivers & Kernel
        row_drv = Adw.ActionRow(
            title="Sürücüler ve Çekirdek" if self.is_tr else "Drivers & Kernel Only",
            subtitle="Kernel, Mesa, Vulkan, firmware ve donanım modülleri." if self.is_tr
                     else "Linux kernel, system firmware, Mesa 3D and graphics drivers."
        )
        btn_drv = Gtk.Button(label="Uygula" if self.is_tr else "Apply", valign=Gtk.Align.CENTER)
        btn_drv.connect("clicked", lambda _: self.run_task(
            "Sürücü Güncellemesi" if self.is_tr else "Driver Update",
            ["pkexec", "/usr/libexec/blazeos-welcome-helper", "update-drivers"]
        ))
        row_drv.add_suffix(btn_drv)
        pref_group.add(row_drv)

        # Security Patches
        row_sec = Adw.ActionRow(
            title="Yalnızca Güvenlik Yamaları" if self.is_tr else "Security Patches Only",
            subtitle="Kritik CVE güvenlik açığı yamaları (hızlı yama)." if self.is_tr
                     else "Fast security updates without upgrading package feature versions."
        )
        btn_sec = Gtk.Button(label="Uygula" if self.is_tr else "Apply", valign=Gtk.Align.CENTER)
        btn_sec.connect("clicked", lambda _: self.run_task(
            "Güvenlik Güncellemesi" if self.is_tr else "Security Update",
            ["pkexec", "/usr/libexec/blazeos-welcome-helper", "update-security"]
        ))
        row_sec.add_suffix(btn_sec)
        pref_group.add(row_sec)

        # DNF Cache Cleaner
        row_clean = Adw.ActionRow(
            title="Önbellek ve Paket Temizliği" if self.is_tr else "Clean DNF Cache & Packages",
            subtitle="İndirme önbelleğini temizler ve disk alanı kurtarır." if self.is_tr
                     else "Cleans downloaded package cache and frees disk space."
        )
        btn_clean = Gtk.Button(label="Temizle" if self.is_tr else "Clean", valign=Gtk.Align.CENTER)
        btn_clean.connect("clicked", lambda _: self.run_task(
            "Önbellek Temizliği" if self.is_tr else "Cache Cleaner",
            ["pkexec", "dnf", "clean", "all"]
        ))
        row_clean.add_suffix(btn_clean)
        pref_group.add(row_clean)

        # Log & Output Group
        log_group = Adw.PreferencesGroup(
            title="İşlem Çıktısı ve Günlükler" if self.is_tr else "Process Output & Logs"
        )
        page.add(log_group)

        self.expander = Adw.ExpanderRow(
            title="Canlı Konsol Çıktısı" if self.is_tr else "Live Console Output",
            subtitle="Çalışan işlemlerin anlık günlük akışı." if self.is_tr else "Real-time process output."
        )
        self.log_buffer = Gtk.TextBuffer()
        log_view = Gtk.TextView(buffer=self.log_buffer, editable=False, monospace=True)
        log_view.set_bottom_margin(8)
        log_view.set_top_margin(8)
        log_view.set_left_margin(12)
        log_view.set_right_margin(12)
        scrolled = Gtk.ScrolledWindow(child=log_view, min_content_height=200)
        self.expander.add_row(scrolled)
        log_group.add(self.expander)

        self.add(page)

    # --------------------------------------------------------------------------
    # 2. DESKTOP PAGE
    # --------------------------------------------------------------------------
    def build_desktop_page(self):
        page = Adw.PreferencesPage()
        page.set_title("Masaüstü" if self.is_tr else "Desktop")
        page.set_icon_name("user-desktop-symbolic")
        page.set_name("desktop")

        pref_group = Adw.PreferencesGroup(
            title="Masaüstü Ortamı ve Oturum Seçimi" if self.is_tr else "Desktop Environment & Session",
            description="Varsayılan masaüstü ortamını belirleyin veya yeni bir ortam kurun." if self.is_tr
                        else "Choose your default desktop session or install additional environments."
        )
        page.add(pref_group)

        # Detect current user session
        current_session = self.get_current_session()

        for de in DESKTOPS_DEF:
            is_installed = any(os.path.exists(p) for p in de["check_files"])
            is_current = (current_session == de["session"])

            desc = de["desc_tr"] if self.is_tr else de["desc_en"]
            if not is_installed:
                desc += (" [Kurulu Değil]" if self.is_tr else " [Not Installed]")

            row = Adw.ActionRow(
                title=de["name"],
                subtitle=desc
            )

            if is_current:
                tag = Gtk.Label(label="Aktif Varsayılan" if self.is_tr else "Active Default", valign=Gtk.Align.CENTER)
                tag.add_css_class("accent")
                tag.add_css_class("heading")
                row.add_suffix(tag)
            elif is_installed:
                btn = Gtk.Button(label="Varsayılan Yap" if self.is_tr else "Set Default", valign=Gtk.Align.CENTER)
                btn.connect("clicked", lambda _, d=de: self.set_desktop_session(d))
                row.add_suffix(btn)
            else:
                btn = Gtk.Button(label="Ortamı Kur" if self.is_tr else "Install", valign=Gtk.Align.CENTER)
                btn.add_css_class("suggested-action")
                btn.connect("clicked", lambda _, d=de: self.install_desktop_environment(d))
                row.add_suffix(btn)

            pref_group.add(row)

        # Shell tweaks group
        tweak_group = Adw.PreferencesGroup(
            title="Masaüstü Kabuk Ayarları" if self.is_tr else "Desktop Shell Tweaks",
            description="SolarUI ve GNOME ek bileşenleri." if self.is_tr else "SolarUI and GNOME shell components."
        )
        page.add(tweak_group)

        # SolarUI Taskbar
        row_taskbar = Adw.ActionRow(
            title="SolarUI Alt Görev Çubuğu" if self.is_tr else "SolarUI Bottom Taskbar",
            subtitle="SolarUI içerisinde alt başlatıcı / görev çubuğunu açıp kapatır." if self.is_tr
                     else "Toggle the bottom application taskbar in SolarUI."
        )
        btn_tb = Gtk.Button(label="Aç / Kapat" if self.is_tr else "Toggle", valign=Gtk.Align.CENTER)
        btn_tb.connect("clicked", lambda _: self.toggle_solar_taskbar())
        row_taskbar.add_suffix(btn_tb)
        tweak_group.add(row_taskbar)

        # GNOME Dash to Dock
        row_dock = Adw.ActionRow(
            title="GNOME Dash to Dock" if self.is_tr else "GNOME Dash to Dock",
            subtitle="GNOME oturumunda klasik kenar/alt dock çubuğunu açıp kapatır." if self.is_tr
                     else "Enable or toggle persistent dock in GNOME session."
        )
        btn_dock = Gtk.Button(label="Aç / Kapat" if self.is_tr else "Toggle", valign=Gtk.Align.CENTER)
        btn_dock.connect("clicked", lambda _: self.toggle_dock())
        row_dock.add_suffix(btn_dock)
        tweak_group.add(row_dock)

        self.add(page)

