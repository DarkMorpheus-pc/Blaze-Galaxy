#!/usr/bin/env bash
# =============================================================================
# BlazeOS Welcome — first-boot setup wizard (v2)
# TR/EN/DE • YAD tabanlı • ayrıcalıklı işler /usr/libexec/blazeos-welcome-helper
# üzerinden TEK pkexec ile • donanım-farkında masaüstü önerisi
# =============================================================================

set -u
SCRIPT_NAME="BlazeOS Welcome"
WIZARD_VERSION="2.0.0"
CONFIG_DIR="$HOME/.config/blazeos"
MARKER_FILE="$CONFIG_DIR/.welcome-completed"
LOGO_PATH="/usr/share/blazeos/icons/blazeos-logo.png"
HELPER="/usr/libexec/blazeos-welcome-helper"

mkdir -p "$CONFIG_DIR"

# --force: uygulama menüsünden yeniden çalıştırınca canlı-geçidi + marker atlanır
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

# ---- CANLI SİSTEM GEÇİDİ ----------------------------------------------------
# Sihirbaz yalnızca KURULU sistemde çalışmalı; Live ISO oturumunda çıkar.
if [ "$FORCE" -eq 0 ] && grep -qE 'rd\.live\.image|root=live:' /proc/cmdline 2>/dev/null; then
    exit 0
fi

# ---- Zaten tamamlandı mı? sessizce çık (--force ile atlanır) ----------------
[ "$FORCE" -eq 0 ] && [ -f "$MARKER_FILE" ] && exit 0

# ---- Dil algıla + kullanıcıya sor ------------------------------------------
SYS_LANG="${LANG%_*}"
case "$SYS_LANG" in
    tr) LANGUAGE=tr ;;
    ru) LANGUAGE=ru ;;
    de) LANGUAGE=de ;;
    *)  LANGUAGE=en ;;
esac

# Dil seçim ekranı — kullanıcı sistem dilini geçersiz kılabilir
LANG_PICK=$(yad \
    --width=360 --height=220 --center --borders=20 \
    --title="BlazeOS Welcome" \
    --text="<b>Select Language / Dil Seç / Выберите язык</b>" \
    --list --separator="" --no-headers \
    --column="Language" \
    "🇹🇷  Türkçe" \
    "🇬🇧  English" \
    "🇷🇺  Русский" \
    --button="OK!gtk-ok:0" 2>/dev/null) && true
case "$LANG_PICK" in
    *Türkçe*)  LANGUAGE=tr ;;
    *English*) LANGUAGE=en ;;
    *Русский*) LANGUAGE=ru ;;
esac

# ---- Donanım: toplam RAM (GB, en yakına yuvarlanmış) ------------------------
MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
MEM_GB=$(( (MEM_KB + 524288) / 1048576 ))
[ "$MEM_GB" -lt 1 ] && MEM_GB=1
# Hafif öneri eşiği: 4 GB ve altı → XFCE/Cinnamon öner
LOW_RAM=0
[ "$MEM_GB" -le 4 ] && LOW_RAM=1

# ---- i18n -------------------------------------------------------------------
