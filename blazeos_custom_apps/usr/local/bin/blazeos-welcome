        tr:btn_continue)     echo "Devam Et" ;;
        tr:btn_ok)           echo "Tamam" ;;
        tr:btn_skip)         echo "Atla" ;;
        tr:btn_back)         echo "← Geri" ;;
        tr:step_update)          echo "Sistem Güncellemesi" ;;
        tr:step_update_text)     echo "Hangi güncelleme türünü yapmak istersin?" ;;
        tr:upd_all)              echo "Tam Güncelleme" ;;
        tr:upd_all_info)         echo "Tüm sistem paketleri, çekirdek, donanım sürücüleri ve güvenlik yamaları güncellenir.\n\nSüre: 10-30 dk\nÖnerilir: Her yeni kurulumdan sonra" ;;
        tr:upd_drivers)          echo "Yalnızca Sürücüler" ;;
        tr:upd_drivers_info)     echo "Kernel, firmware, Mesa/Vulkan grafik sürücüleri ve donanım modülleri güncellenir.\n\nSüre: 5-15 dk\nÖnerilir: Yeni donanım veya ekran/ses sorunları varsa" ;;
        tr:upd_security)         echo "Yalnızca Güvenlik" ;;
        tr:upd_security_info)    echo "Yalnızca CVE güvenlik yamaları uygulanır. Sürümler değişmez.\n\nSüre: 1-10 dk\nÖnerilir: Hızlı ve güvenli yama" ;;
        tr:upd_packages)         echo "Yalnızca Bileşenler" ;;
        tr:upd_packages_info)    echo "Uygulamalar ve kütüphaneler güncellenir. Çekirdek/sürücüler hariç.\n\nSüre: 5-20 dk\nÖnerilir: Çekirdek değiştirmek istemiyorsan" ;;
        tr:upd_info_btn)         echo "ℹ" ;;
