# ---- YAD ortak args ---------------------------------------------------------
YAD_BASE=(
    --window-icon="$LOGO_PATH"
    --image="$LOGO_PATH"
    --image-on-top
    --width=580
    --height=400
    --center
    --borders=20
    --title="$SCRIPT_NAME"
)

yad_confirm() {
    yad "${YAD_BASE[@]}" \
        --text="<b>$1</b>\n\n$2" \
        --button="$(t btn_skip)!gtk-cancel:1" \
        --button="$(t btn_continue)!gtk-ok:0"
}

yad_info() {
    yad "${YAD_BASE[@]}" --text="<b>$1</b>\n\n$2" --button="OK:0"
}

# ---- Mor progress bar teması -------------------------------------------------
# Context Check: progress bar görünümü
# GtkProgressBar'ın .trough > .progress düğümünü mor'a boyuyoruz. Hem
# determinate (yüzdeli) hem activity/pulse modunda aynı renk kullanılır.
# (blazeos-control da aynı dosyayı üretir/kullanır — içerik özdeş.)
PROGRESS_CSS_FILE="$CONFIG_DIR/.progress.css"
cat > "$PROGRESS_CSS_FILE" <<'CSS_EOF'
progressbar trough progress, progressbar trough progress.pulse {
    background-color: #9b30ff;
    background-image: none;
    border-radius: 6px;
}
progressbar trough {
    border-radius: 6px;
    min-height: 14px;
}
CSS_EOF

# ---- Ayrıcalıklı işi helper'a devret — canlı log + hız + yüzde -----------
# Context Check: pipe + heredoc çakışması DÜZELTİLDİ
# python3 -u - <<'PYPARSER' pipeline içinde stdin zaten pipe'tan geldiği için
# heredoc çalışmıyordu (boş stdin → boş log). Çözüm: parser ayrı dosya olarak
# /usr/libexec/blazeos-progress-parser'a kuruldu (kickstart %post).
PARSER="/usr/libexec/blazeos-progress-parser"
run_privileged() {
    local title="$1"; shift
    local done_flag log_file
    done_flag="$(mktemp -u)"
    log_file="$(mktemp)"
    rm -f "$done_flag"

    {
        (
            if [ -x "$PARSER" ]; then
                stdbuf -oL -eL pkexec "$HELPER" "$@" 2>&1 | \
                    stdbuf -oL tr '\r' '\n' | \
                    python3 -u "$PARSER" "$log_file"
            else
                # Fallback: parser yoksa basit mod
                stdbuf -oL -eL pkexec "$HELPER" "$@" 2>&1 | \
                    stdbuf -oL tr '\r' '\n' | \
                    while IFS= read -r line; do
                        [ -z "$line" ] && continue
                        if [[ "$line" =~ \[([0-9]+)/([0-9]+)\] ]]; then
                            local n="${BASH_REMATCH[1]}" m="${BASH_REMATCH[2]}"
                            [ "$m" -gt 0 ] && echo "$(( n * 100 / m ))"
                        fi
                        echo "# ${line:0:80}"
                    done
            fi
            touch "$done_flag"
        ) &
        local main_pid=$!

        (
            while [ ! -f "$done_flag" ]; do
                echo "#"
                sleep 0.1
            done
        ) &
        local heartbeat_pid=$!

        wait "$main_pid"
        kill "$heartbeat_pid" 2>/dev/null
        wait "$heartbeat_pid" 2>/dev/null
        rm -f "$done_flag" "$log_file"
        echo "100"
    } | yad "${YAD_BASE[@]}" \
        --width=620 --height=520 \
        --css="$PROGRESS_CSS_FILE" \
        --progress --pulsate --auto-close --no-buttons \
        --text="<b>$title</b>"
}

# ---- Step 0: welcome --------------------------------------------------------
yad_info "$(t welcome_title)" "$(t welcome_text)" || exit 0

# ---- Step 1: Sistem Güncellemesi (dikey liste — 1366x768 uyumlu) -----------
# Context Check: güncelleme adımı — yatay buton sırası 1366x768'de taşıyordu.
# Çözüm: 2 sütunlu liste (seçenek adı + araç ipucu).  ℹ: seçenekte hover.
UPD_RC=0
while true; do
    UPD_SEL=$(yad "${YAD_BASE[@]}" \
        --width=560 --height=360 \
        --text="<b>$(t step_update)</b>\n\n$(t step_update_text)" \
        --list --separator="|" --no-headers --mid-search \
        --column="$(t col_pick)" \
        --column="ℹ":TIP \
        "$(t upd_all)"      "$(t upd_all_info)" \
        "$(t upd_drivers)"  "$(t upd_drivers_info)" \
        "$(t upd_packages)" "$(t upd_packages_info)" \
        "$(t upd_security)" "$(t upd_security_info)" \
        --button="$(t btn_skip)!gtk-cancel:1" \
        --button="$(t btn_continue)!gtk-ok:0" \
        2>/dev/null)
    UPD_RC=$?
    [ "$UPD_RC" -ne 0 ] && break
    UPD_NAME="${UPD_SEL%%|*}"
    case "$UPD_NAME" in
        "$(t upd_all)")      run_privileged "$(t upd_all)"      update-all;      break ;;
        "$(t upd_drivers)")  run_privileged "$(t upd_drivers)"  update-drivers;  break ;;
        "$(t upd_packages)") run_privileged "$(t upd_packages)" update-packages; break ;;
        "$(t upd_security)") run_privileged "$(t upd_security)" update-security; break ;;
        *) break ;;
    esac
done




# ---- Step 2: Masaüstü ortamı (donanım-farkında, TEK seçim) ------------------
if [ "$LOW_RAM" -eq 1 ]; then
    RAM_BANNER="$(t ram_low)"
else
    RAM_BANNER="$(t ram_ok)"
fi

# Düz liste (checklist DEĞİL): kullanıcı satıra tıklar, Devam Et'e basar.
# --separator="" → çıktı sadece seçilen satırın metni (örn "XFCE").
DE_SEL=$(yad "${YAD_BASE[@]}" \
    --text="<b>$(t step_de)</b>\n\n$(t step_de_intro)\n\n$RAM_BANNER\n\n<i>$(t de_hint)</i>" \
    --list --separator="" --no-headers \
    --column="$(t col_de)" \
    "XFCE" \
    "Cinnamon" \
    "MATE" \
    "KDE Plasma" \
    "COSMIC" \
    "Hyprland" \
    "Niri" \
    --button="$(t btn_skip)!gtk-cancel:1" \
    --button="$(t btn_continue)!gtk-ok:0")

if [ -n "$DE_SEL" ]; then
    PKGS=()
    case "$DE_SEL" in
        XFCE*)     PKGS+=("@xfce-desktop-environment") ;;
        Cinnamon*) PKGS+=("@cinnamon-desktop-environment") ;;
        MATE*)     PKGS+=("@mate-desktop-environment") ;;
        # KDE: tam app suite (@kde-desktop-environment) yerine yalın Plasma
        # çekirdeği — KMail/KTorrent/Kamoso/K3b/Krusader seli gelmez.
        KDE*)      PKGS+=("plasma-desktop" "sddm" "konsole" "dolphin"
                          "plasma-nm" "plasma-pa" "kscreen" "plasma-systemmonitor"
                          "ark" "kde-gtk-config" "breeze-gtk") ;;
        COSMIC*)   PKGS+=("@cosmic-desktop-environment") ;;
        Hyprland*) PKGS+=("hyprland" "kitty" "waybar" "wofi" "wlogout") ;;
        Niri*)     PKGS+=("niri" "waybar" "fuzzel" "mako" "xwayland-satellite" "polkit-gnome" "swaylock") ;;
    esac
    if [ "${#PKGS[@]}" -gt 0 ]; then
        run_privileged "$(t step_de)" install-de "${PKGS[@]}"
        # GNOME kaldırma teklifi (giriş yöneticisi güvenli şekilde değiştirilir)
        if yad_confirm "$(t de_rmgnome_t)" "$(t de_rmgnome)"; then
            run_privileged "$(t de_rmgnome_t)" remove-gnome "$DE_SEL"
        fi
        # Yeni masaüstüne nasıl geçilir
        yad "${YAD_BASE[@]}" --info --button="$(t btn_ok)!gtk-ok:0" \
            --text="<b>$(t de_done_t)</b>\n\n$(t de_switch)"
    fi
fi

# ---- Step 3: Dock (yalnız GNOME oturumunda anlamlı) ------------------------
# Context Check: dock seçimi
# Yalnızca aktif oturum GNOME Shell ise gösterilir (XDG_CURRENT_DESKTOP).
# Başka bir DE'ye geçilmişse (Step 2'de) bu adım atlanır — dash-to-dock
# GNOME Shell'e özgü bir uzantıdır, başka DE'de anlamsız/zararlı olur.
# (Dash to Panel BİLEREK sunulmuyor — Fedora'nın paketlediği sürüm GNOME 50
# ile kod düzeyinde uyumsuz, bkz. helper'daki set-dock yorumu.)
if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
    if yad_confirm "$(t step_dock)" "$(t step_dock_intro)"; then
        run_privileged "$(t step_dock)" set-dock dash-to-dock
    fi
fi

# ---- Step 4: Waydroid (opt-in) ---------------------------------------------
if yad_confirm "$(t step_waydroid)" "$(t step_waydroid_text)"; then
    run_privileged "$(t step_waydroid)" waydroid
fi

# ---- Step 5: Done -----------------------------------------------------------
yad_info "$(t step_done)" "$(t step_done_text)"

# ---- Mark complete ----------------------------------------------------------
{
    echo "completed_at=$(date -Iseconds)"
    echo "version=$WIZARD_VERSION"
    echo "ram_gb=$MEM_GB"
} > "$MARKER_FILE"

exit 0
