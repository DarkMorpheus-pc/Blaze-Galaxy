{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/blazeos/fastfetch/logo.ans",
        "padding": {
            "top": 1,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "red",
            "title": "red"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;255;87;34m╔══ BlazeOS Galaxy SolarEvolution ══════════════════════════╗\u001b[0m"
        },
        {
            "type": "title",
            "format": "\u001b[1;38;2;244;67;54m{user-name}\u001b[0m@\u001b[1;38;2;255;152;0m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;87;34m╠═══════════════════════════════════════════════════════════╣\u001b[0m"
        },
        { "type": "os",       "key": " OS         " },
        { "type": "kernel",   "key": " Kernel     " },
        { "type": "uptime",   "key": " Uptime     " },
        { "type": "packages", "key": " Packages   " },
        { "type": "shell",    "key": " Shell      " },
        { "type": "wm",       "key": " WM         " },
        { "type": "de",       "key": " DE         " },
        { "type": "terminal", "key": " Terminal   " },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;87;34m╠═══════════════════════════════════════════════════════════╣\u001b[0m"
        },
        { "type": "cpu",    "key": " CPU        " },
        { "type": "gpu",    "key": " GPU        " },
        { "type": "memory", "key": " Memory     " },
        { "type": "disk",   "key": " Disk       " },
        {
            "type": "custom",
            "format": "\u001b[38;2;255;87;34m╚═══════════════════════════════════════════════════════════╝\u001b[0m"
        },
        "break",
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
