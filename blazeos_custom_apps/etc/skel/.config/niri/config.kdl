// BlazeOS — Niri Varsayılan Konfigürasyonu
// Daha fazla bilgi: https://github.com/YaLTeR/niri/wiki/Configuration

input {
    keyboard {
        xkb {
            // Klavye düzenini buradan ayarlayın
            // layout "tr"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

outputs {
    // Ekran ayarları otomatik algılanır
}

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#9b30ff"
        inactive-color "#505050"
    }

    border {
        off
    }
}

prefer-no-csd

screenshot-path "~/Resimler/Ekran Görüntüsü %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0
}

// Uygulamalar
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "xwayland-satellite"

binds {
    // Uygulama başlatıcı (Süper + R veya Süper + D)
    Mod+R { spawn "fuzzel"; }
    Mod+D { spawn "fuzzel"; }

    // Terminal
    Mod+Return { spawn "bash" "-c" "kgx || gnome-terminal || xterm"; }

    // Pencere kapatma
    Mod+Q { close-window; }

    // Odak taşıma
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Pencere taşıma
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Çalışma alanı
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }

    // Ekran görüntüsü
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Tam ekran
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Niri'yi yeniden başlat
    Mod+Shift+E { quit; }
}
