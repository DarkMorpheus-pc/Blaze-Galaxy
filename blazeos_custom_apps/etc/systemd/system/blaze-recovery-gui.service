[Unit]
Description=BlazeOS Recovery Environment (BERP Recovery - GUI)
DefaultDependencies=no
Conflicts=shutdown.target getty@tty1.service kmsconvt@tty1.service plymouth-quit-wait.service
After=systemd-remount-fs.service systemd-vconsole-setup.service systemd-udevd.service systemd-udev-settle.service dbus.service
Wants=systemd-udev-settle.service dbus.service
Conflicts=display-manager.service graphical.target
Before=shutdown.target display-manager.service graphical.target
# Never silently replace the graphical BERE entry with the text BERP menu.
# If the compositor fails, systemd keeps the failure visible in the journal so
# the user can explicitly choose the BERP console entry from GRUB.

[Service]
User=root
Environment=HOME=/root
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=TERM=linux
WorkingDirectory=/root
ExecStartPre=-/usr/bin/mkdir -p /run/user/0
ExecStartPre=-/usr/bin/chmod 0700 /run/user/0
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/bin/blaze-recovery-gui-launcher
TimeoutStartSec=30s
Type=simple
Restart=no
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=mixed

[Install]
WantedBy=blaze-recovery-gui.target
