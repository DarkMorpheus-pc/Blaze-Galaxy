[Unit]
Description=Blaze Emergency Recovery Protocol (BERP) Console UI
DefaultDependencies=no
Conflicts=shutdown.target getty@tty1.service kmsconvt@tty1.service plymouth-quit-wait.service
After=systemd-remount-fs.service systemd-vconsole-setup.service
Before=shutdown.target

[Service]
Environment=HOME=/root
Environment=TERM=linux
WorkingDirectory=/root
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/bin/blaze-recovery
Type=idle
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=blaze-recovery.target
