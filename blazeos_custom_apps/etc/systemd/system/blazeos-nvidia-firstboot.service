[Unit]
Description=BlazeOS NVIDIA İlk Başlatma Sürücü Kurulumu
Documentation=https://blazeos.com.tr
After=network-online.target display-manager.service
Wants=network-online.target
ConditionPathExists=!/var/lib/blazeos/nvidia-setup-done
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecCondition=/usr/bin/sh -c '/usr/bin/lspci 2>/dev/null | /usr/bin/grep -iq nvidia'
ExecStart=/usr/local/bin/blazeos-nvidia-setup
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=graphical.target
