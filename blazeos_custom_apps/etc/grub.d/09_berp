#!/usr/bin/sh -e
# Blaze Emergency Recovery Protocol (BERP) Early Shift & Watchdog Hook

cat << 'BERPEOF'
# === Blaze Emergency Recovery Protocol (BERP) Early Shift Detection ===
if [ "${grub_platform}" = "pc" ]; then
  if insmod keystatus; then
    if keystatus --shift; then
      set default="BlazeOS Recovery Environment (BERE - Powered by BERP)"
      set timeout=2
    fi
  fi
fi

if [ "${blaze_recovery}" = "alert" ]; then
  set default="BlazeOS Recovery Environment (BERE - Powered by BERP)"
  set timeout=0
fi
BERPEOF

