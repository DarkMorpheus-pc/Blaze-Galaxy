#!/usr/bin/sh -e
# Blaze Emergency Recovery Protocol (BERP) watchdog hook

cat << 'BERPEOF'
# GRUB keystatus is unreliable on some UEFI/USB keyboards and can report a
# phantom Shift press, booting recovery forever. Recovery remains available
# from the visible menu and its Space/B hotkeys.
if [ "${blaze_recovery}" = "alert" ]; then
  set default="BlazeOS Recovery Environment (BERE - Powered by BERP)"
  set timeout=0
fi
BERPEOF
